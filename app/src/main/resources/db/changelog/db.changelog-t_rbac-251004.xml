<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd
                      http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet id="db.changelog-t_rbac-251004" author="anas" labels="rbac">
    <createTable
      tableName="T_RBAC">
      <!-- Metadata START -->
      <column name="ID" type="UUID">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="IS_DEL" type="BOOLEAN">
        <constraints nullable="false" />
      </column>
      <column name="VER" type="INTEGER">
        <constraints nullable="false" />
      </column>
      <column name="CREATE_BY" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="CREATE_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
      <column name="UPDATE_BY" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="UPDATE_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
      <!-- Metadata END   -->
      <column name="ROLE" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="ACC_LS" type="VARCHAR(250)">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addUniqueConstraint tableName="T_RBAC" columnNames="ROLE" />

    <createIndex indexName="IX_RBAC_ROLE_IS_DEL" tableName="T_RBAC">
      <column name="ROLE" />
      <column name="IS_DEL" />
    </createIndex>
  </changeSet>
</databaseChangeLog>
