<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd
                      http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

  <changeSet id="db.changelog-t_rbac-251004" author="anas" labels="rbac">
    <createTable
      tableName="T_RBAC">
      <!-- Metadata START -->
      <column name="ID" type="UUID">
        <constraints primaryKey="true" nullable="false" />
      </column>
      <column name="IS_DEL" type="BOOLEAN">
        <constraints nullable="false" />
      </column>
      <column name="VER" type="INTEGER">
        <constraints nullable="false" />
      </column>
      <column name="CREATE_BY" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="CREATE_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
      <column name="UPDATE_BY" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="UPDATE_DT" type="TIMESTAMP WITH TIME ZONE">
        <constraints nullable="false" />
      </column>
      <!-- Metadata END   -->
      <column name="ROL" type="VARCHAR(20)">
        <constraints nullable="false" />
      </column>
      <column name="ACCS_LS" type="VARCHAR(250)">
        <constraints nullable="false" />
      </column>
      <column name="IS_SUPERADMIN" type="BOOLEAN">
        <constraints nullable="false" />
      </column>
    </createTable>

    <addUniqueConstraint tableName="T_RBAC" columnNames="ROL" />

    <createIndex indexName="IX_RBAC_ROL_IS_DEL" tableName="T_RBAC">
      <column name="ROL" />
      <column name="IS_DEL" />
    </createIndex>

    <sql>
      <![CDATA[
        INSERT INTO T_RBAC (ID, IS_DEL, VER, CREATE_BY, CREATE_DT, UPDATE_BY, UPDATE_DT, ROL, ACCS_LS, IS_SUPERADMIN)
        VALUES('36e54fdc-6470-4ad0-8546-13d6e3040a47', false, 0, 'SYSTEM', CURRENT_TIMESTAMP, 'SYSTEM', CURRENT_TIMESTAMP, 'SUPERADMIN', '["FULL_ACCS"]', true);
      ]]>
      <comment>Add role[SUPERADMIN]</comment>
    </sql>
  </changeSet>
</databaseChangeLog>
