Accept: application/json
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

###

# Add role
POST {{BASE_URL}}/api/v1/rbac/role
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{TOKEN}}

{
  "role": "TEST",
